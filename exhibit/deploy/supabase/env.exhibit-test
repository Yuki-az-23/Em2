# Non-secret .env overrides for the exhibit's test Supabase stack.
#
# bootstrap-vm.sh upserts each KEY=VALUE line below into
# /opt/exhibit-test/supabase/.env (replace the line if the key exists, else
# append), after replacing @DOMAIN@ with DOMAIN from /etc/exhibit-test/config.
# Lines starting with # and blank lines are ignored.
#
# No secrets belong in this file. Keys and passwords come from upstream
# utils/generate-keys.sh and live only in .env on the VM (root, mode 600).
#
# PGRST_DB_EXTRA_SEARCH_PATH is deliberately not set: the healthcheck's HTTP
# react_to_post probe must still fail with 42883 if schema.sql's pinned
# function search_path is missing.

# Public URLs. In v0.8.4's .env.example API_EXTERNAL_URL carries /auth/v1.
SUPABASE_PUBLIC_URL=https://api-test.@DOMAIN@
API_EXTERNAL_URL=https://api-test.@DOMAIN@/auth/v1
SITE_URL=https://exhibit-test.@DOMAIN@
ADDITIONAL_REDIRECT_URLS=https://exhibit-test.@DOMAIN@/reset-password

# No SMTP in the test deployment: confirm email signups automatically.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# The gateway listens on the VM's loopback only; cloudflared reaches it there.
API_GW_HTTP_PORT=127.0.0.1:8000

# Our override: functions and supavisor off, log caps on.
COMPOSE_FILE=docker-compose.yml:docker-compose.exhibit.yml

# Studio basic auth user (the password is generated into .env).
DASHBOARD_USERNAME=exhibit
