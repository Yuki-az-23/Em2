{
  // Hermes on Cloudflare Workers. Secrets are set with `wrangler secret put`:
  //   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "AI_TEXT_MODEL": "@cf/openai/gpt-oss-120b",
    "AI_IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    "PUBLIC_IMAGE_BASE": "",            // e.g. https://images.<domain> (R2 custom domain) ; empty = images stay unpublished
    "PIPELINE_MAX_ATTEMPTS": "3"
  },
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "hermes-images" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "routes": [{ "pattern": "hermes.example.invalid", "custom_domain": true }],

  // The test deployment: `npx --no-install wrangler deploy --env test` (deploy/cloudflare-test.sh).
  // Bindings, vars and routes are not inherited by an env, so each is repeated here.
  // The domain below is the default; cloudflare-test.sh refuses to run if it differs
  // from DOMAIN in the handoff file.
  "env": {
    "test": {
      "name": "hermes-test",
      "workers_dev": false,               // reachable only through the zone, no *.workers.dev twin
      "preview_urls": false,
      "vars": {
        "AI_TEXT_MODEL": "@cf/openai/gpt-oss-120b",
        "AI_IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
        "PUBLIC_IMAGE_BASE": "https://images-test.solorpunk.com",
        "PIPELINE_MAX_ATTEMPTS": "3"
      },
      "ai": { "binding": "AI" },
      "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "hermes-images-test" }],
      "triggers": { "crons": ["*/10 * * * *"] },
      "routes": [{ "pattern": "hermes-test.solorpunk.com", "custom_domain": true }]
    }
  }
}
